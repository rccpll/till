{
  "name": "till",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "wrangler pages dev dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply till --local",
    "db:migrate:prod": "wrangler d1 migrations apply till --remote",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.0.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "bwip-js": "^4.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^4.10.38",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0",
    "zxing-wasm": "^3.1.3"
  }
}
